// Cloudflare 배포 설정: web/ 폴더를 정적 사이트로 배포한다 (빌드 없음).
// Workers 화면에서 연결한 경우 Deploy command 기본값(npx wrangler deploy)이 이 파일을 사용한다.
// "name"은 Cloudflare 대시보드의 Worker 이름과 같아야 한다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spliit",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./web"
  }
}
